# Byte-exact payloads the build verifies by hash; EOL normalization on any of
# these (including the toolchain's headers) would silently break byte-matching.
baselines/** -text
build/toolchains/vs2003/** -text

# The built mod executable. Same reasoning as baselines/: it is a byte-exact
# artifact whose hash is recorded in mods/dist/manifest.json, and any EOL
# normalization would corrupt it.
mods/dist/** -text

# Append-mostly ledgers written concurrently by many agents. The built-in union
# merge driver combines both sides' added lines instead of emitting conflict
# markers, so parallel row appends never conflict. Run tools/dedup_csv.py after
# a merge if the full build reports a duplicate/overlap (two agents claimed one
# shared COMDAT address).
reverse/functions.csv merge=union
reverse/symbols.csv merge=union
# The counterweight to functions.csv being union-merged: a deletion there is
# invisible to a merge, and this file is the only record of one. It has to
# union-merge too, or retracting a batch of rows conflicts with every branch in
# flight at exactly the moment the escape hatch is needed.
reverse/deleted_rows.csv merge=union
reverse/re_attempts.log merge=union
# so it deliberately gets no union merge.
