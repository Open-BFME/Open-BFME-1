# Byte-exact payloads the build verifies by hash; EOL normalization on any of
# these (including the toolchain's headers) would silently break byte-matching.
inputs/baselines/** -text
inputs/toolchains/vs2003/** -text

# The built mod executable. Same reasoning as inputs/baselines/: it is a byte-exact
# artifact whose hash is recorded in mods/dist/manifest.json, and any EOL
# normalization would corrupt it.
mods/dist/** -text

# Append-mostly ledgers written concurrently by many agents. Union merge
# combines both sides' added lines instead of emitting conflict markers, so
# parallel row appends never conflict. git's built-in union also brings back
# rows one side deleted or edited, so clones register tools/merge_rows.py under
# the name `union` (tools/setup_hooks.sh, .githooks/pre-commit) to remove them;
# a clone without it still gets plain union, never a conflict. Two agents
# claiming one shared COMDAT address is an identity question, not a merge one.
targets/game/reverse/functions.csv merge=union
targets/game/reverse/symbols.csv merge=union
# data_rows.csv (tools/data_rows.py): one owner per address, appended like the others
targets/game/reverse/data_rows.csv merge=union
# The counterweight to functions.csv being union-merged: a deletion there is
# invisible to a merge, and this file is the only record of one. It has to
# union-merge too, or retracting a batch of rows conflicts with every branch in
# flight at exactly the moment the escape hatch is needed.
targets/game/reverse/deleted_rows.csv merge=union
targets/game/reverse/name_votes.csv merge=union
targets/game/reverse/name_agreed.csv merge=union
targets/game/reverse/name_vote_receipts.jsonl merge=union
targets/game/reverse/re_attempts.log merge=union
# A JSON list cannot union-merge; tools/merge_json_list.py merges it as a set of
# entries (registered by tools/setup_hooks.sh; unregistered clones fall back to
# an ordinary text merge).
targets/game/reverse/name_corrections.json merge=jsonlist
# so it deliberately gets no union merge.

# Target ledgers remain independent; validation rejects overlapping appends.
targets/worldbuilder/reverse/functions.csv text eol=lf merge=union
targets/worldbuilder/reverse/attempts.jsonl text eol=lf merge=union
# Attempt hashes bind the exact saved source, including its line endings.
targets/worldbuilder/reverse/attempts/*.cpp -text
targets/worldbuilder/reverse/*.json text eol=lf
targets/worldbuilder/*.json text eol=lf
targets/worldbuilder/dependencies/*.csv text eol=lf

# Game ledgers are LF in the index (research 17: on Windows clones with
# core.autocrlf=true, ledgers picked up CRLF lines, and a rebased union merge
# came out 
). Pinned per file type so a new ledger is covered on arrival.
targets/game/reverse/*.csv text eol=lf
targets/game/reverse/*.tsv text eol=lf
targets/game/reverse/*.txt text eol=lf
targets/game/reverse/*.log text eol=lf
targets/game/reverse/*.json text eol=lf
targets/game/reverse/**/*.csv text eol=lf
targets/game/reverse/**/*.tsv text eol=lf
# Still CRLF in the index and too large to renormalise outside a publish
# window (every in-flight branch would conflict on every line). They keep
# today's autocrlf behaviour until one commit renormalises each of them;
# that commit deletes its line here.
targets/game/reverse/functions.csv !text !eol
targets/game/reverse/symbols.csv !text !eol
targets/game/reverse/re_attempts.log !text !eol
targets/game/reverse/name_corrections.json !text !eol
targets/game/reverse/field_names.csv !text !eol
targets/game/reverse/exports.csv !text !eol
targets/game/reverse/zh_sweep/drift_report.csv !text !eol
