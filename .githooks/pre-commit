#!/usr/bin/env bash
# Commit gate: static ledger integrity plus byte-verification of the delta.
# Header and shim changes automatically receive the full gate; pre-push checks
# the outgoing delta again. Never bypass this hook.
set -euo pipefail

# Publication verifies every affected target; worker selection must not redirect its checks.
unset BFME_TARGET BFME_TARGET_SHA256
# This hook hands mktemp's /tmp paths and build.sh its /c/... script path to native
# Python and relies on Git Bash converting them. MSYS_NO_PATHCONV=1, exported to type
# cl.exe flags by hand, turns that off: Python then reads /tmp/tmp.XXXX as C:\tmp\...,
# and a commit with anything to verify failed "filtering claimed sources".
unset MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL
# Compiler state a caller exported must not reach the byte gate: BUILD_RECOMPILE_ONLY
# reuses every unlisted object (valid only for callers that prove untouched TUs), and
# CL/_CL_ add flags to every cl.exe the build runs. pre-push unsets the same three.
unset BUILD_RECOMPILE_ONLY CL _CL_

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Ledger receipt for post-commit (see the end of this hook). Clear any stale one
# first: every exit path below except a fully verified stable tree leaves none.
receipt="$(git rev-parse --git-path bfme-ledger-verified-tree 2>/dev/null || true)"
[ -z "$receipt" ] || rm -f "$receipt" 2>/dev/null || true

# Beside the hook, not the tree: tests and seats run copies of a hook elsewhere;
# a copy without its helper uses python3 as before.
. "$(dirname "${BASH_SOURCE[0]}")/python3.sh" 2>/dev/null || require_python3() { :; }
require_python3 pre-commit

fail() {
    echo "PRE-COMMIT FAILED: $*" >&2
    exit 1
}

# capture VAR WHAT CMD...: run CMD into a new temp file, store its path in VAR, and fail
# naming WHAT if CMD fails. `< <(cmd)` and `$(cmd)` drop the producer's exit status, so a
# failed listing read as an empty one and the hook verified less instead of refusing.
capture() {
    local captured
    captured=$(mktemp) || fail "temporary file for $2"
    "${@:3}" > "$captured" || { rm -f "$captured"; fail "$2 (see above)"; }
    printf -v "$1" '%s' "$captured"
}

# Clones set up before tools/merge_rows.py existed never rerun setup_hooks.sh;
# this is how they pick up the union driver (.gitattributes says why), and how
# clones registered with a bare `python3` (the Windows Store shortcut) get
# .githooks/run-python3's py -3 fallback.
for driver in "union:tools/merge_rows.py %O %A %B %P" "jsonlist:tools/merge_json_list.py %O %A %B"; do
    want="sh .githooks/run-python3 ${driver#*:}"
    if [ "$(git config --get "merge.${driver%%:*}.driver" || true)" != "$want" ]; then
        git config "merge.${driver%%:*}.driver" "$want"
        echo "pre-commit: registered ${driver#*:} as this clone's ${driver%%:*} merge driver" >&2
    fi
done

# No two tracked paths may differ only in case — such a pair cannot check out on
# Windows/macOS (case-insensitive FS), silently dropping a file and breaking those
# clones. Reflects the staged index, so a colliding add is caught before it lands.
# Control paths (the root, targets/, tools/, .githooks/, .github/) are also refused
# unless lowercase: every gate reads a ledger or baseline by its exact spelling, and
# would verify nothing through targets/game/reverse/Data_Rows.csv.
python3 tools/check_case_collisions.py \
    || fail "case-only path collision, or a control path not spelled as the hooks read it (see above)"

# A script under tools/ is neither a game/ source nor a ledger file, so nothing
# else in this hook looks at it: one with a syntax error commits cleanly and only
# fails when somebody next runs it. That has happened. One parse per staged tool
# costs nothing and closes it. The list goes through a file: as arguments, a few hundred
# staged tools would pass Windows' 32,767-character command line.
capture staged_tools_out "listing staged tools" git diff --cached --name-only -z --diff-filter=ACM -- 'tools/*.py'
if [ -s "$staged_tools_out" ]; then
    python3 - "$staged_tools_out" <<'PY' || { rm -f "$staged_tools_out"; fail "python syntax error in a staged tool (see above)"; }
import ast, os, sys
bad = 0
for path in map(os.fsdecode, open(sys.argv[1], "rb").read().split(b"\0")[:-1]):
    try:
        ast.parse(open(path, encoding="utf-8").read(), filename=path)
    except SyntaxError as exc:
        print("  %s:%s: %s" % (path, exc.lineno, exc.msg), file=sys.stderr)
        bad = 1
sys.exit(bad)
PY
fi
rm -f "$staged_tools_out"

# docs/lessons.md is deleted and must stay that way. It was designated the one doc
# agents could extend without asking, and it grew to 82,688 words; the grant was
# removed on 2026-08-01 and 541 more commits went into it; it was distilled to 206
# lines on 2026-08-13 and grew back to 2,565 -- 7.4x in thirty days, past the ~2,000
# line cap written in its own header. Two prose bans did not hold it. By the end the
# two sections other files cited BY NAME ("A pinharvest row is a candidate", "Union-
# merge duplicate row") no longer existed in it, so it had stopped working as a
# reference as well. An operational fact belongs in the commit message, in the tool
# that enforces it, or next to the code it is about -- not in a growing middens.
# Through a file, not a pipe: under pipefail, `grep -q` exiting at its match killed
# a long `git diff` with SIGPIPE, the pipeline failed, and the ban never fired.
# Case-insensitive: Docs/Lessons.md is the same file on Windows and macOS.
capture staged_names_out "listing staged files" git diff --cached --name-only --diff-filter=ACMR
if grep -qiE '^docs/lessons(-archive)?\.md$' "$staged_names_out"; then
    rm -f "$staged_names_out"
    fail "docs/lessons.md was deleted deliberately; put the fact where it is enforced, not in a new middens"
fi
rm -f "$staged_names_out"

# Direction: conversions run asm -> C++, never the reverse. Byte-verification
# cannot see this (an __emit lift of a retail dump is byte-true), so it gets
# its own gate: no new naked/__emit bodies outside game/gen_small/, and no
# clean-C++ ledger row repointed back at assembly.
layout_base=HEAD
merge_head=$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null || true)
if [ -n "$merge_head" ] \
   && [ "$(python3 tools/layout_migration.py detect "$merge_head" : || true)" = layout-migration ]; then
    # The fleet's already-published rows are relocated by this merge, not minted
    # by it. The exact mapping check below proves the merged parent's claims.
    layout_base="$merge_head"
fi
python3 tools/conversion_gate.py "$layout_base" : || fail "conversion direction (see above)"
# Historical names survive source moves and opaque owner renames.
# Execute the reviewed checker, not an unstaged local experiment.
for checker in tools/name_regression.py tools/name_oracle.py; do
    git cat-file -e ":$checker" && git diff --quiet -- "$checker" \
        || fail "name checker differs from staged snapshot: $checker; stage or revert its edits"
done
python3 tools/name_regression.py "$layout_base" : || fail "descriptive names regressed (see above)"
# A three-body edit must not ride on a whole-file line-ending rewrite (mixed-
# terminator sources under core.autocrlf=true lose every CR on `git add`).
python3 tools/eol_guard.py || fail "staged change rewrites line endings (see above)"
# A deliberately deleted file may not come back by accident (targets/game/reverse/retired_paths.txt).
python3 tools/retired_guard.py --staged || fail "retired path re-added (see above)"
# The docs agents load may not grow back; written bans never held one.
python3 tools/doc_budget.py --staged || fail "doc budget (see above)"
# This hook runs from the main checkout for every worktree, so a tree older than a checker has
# no copy of it until it rebases; say so instead of refusing every commit the tree makes.
present() { [ -f "$1" ] || { echo "pre-commit: $1 is newer than this tree; rebase to enable its check" >&2; return 1; }; }
present tools/ea_name_guard.py && { python3 tools/ea_name_guard.py --staged || fail "a name contradicts EA evidence (see above)"; }
present tools/name_lane.py && { python3 tools/name_lane.py check --staged || fail "a placeholder was renamed outside the naming lane (see above)"; }
present tools/ilt_guard.py && { python3 tools/ilt_guard.py --staged || fail "retail's thunk table contradicts a new name (see above)"; }
# A literal image address matches bytes but breaks the linked build; name the global.
python3 tools/link_debt.py --staged || fail "new hard-coded image address (see above)"
# An /alternatename alias must name the body at its alias's pinned address.
present tools/alias_guard.py && { python3 tools/alias_guard.py --staged || fail "an alias binds a call to another body (see above)"; }
present tools/hatch_counters.py && { python3 tools/hatch_counters.py --staged || fail "escape hatches grew or a retail inventory was hand-edited (see above)"; }
# Structure invariants, SHADOW: one owner per retail address, rows only into their
# approved TU (targets/game/reverse/tu_map.csv), no private copy of a registered class.
# Reports, never refuses, until its measured false-rejection rate is under budget.
present tools/tu_ownership.py && { python3 tools/tu_ownership.py --staged --shadow || echo "pre-commit: tu_ownership shadow check failed to run (ignored)" >&2; }

# WorldBuilder has a separate image and ledger; verify it before the game-only
# early exit, then keep its exclusive sources out of the game's source parser.
git cat-file -e :tools/target_hooks.py && git diff --quiet -- tools/target_hooks.py \
    || fail "target checker differs from staged snapshot; stage or revert its edits"
target_sources_out=$(mktemp)
python3 tools/target_hooks.py --staged --exclusive-output "$target_sources_out" \
    || { rm -f "$target_sources_out"; fail "WorldBuilder target verification (see above)"; }
declare -A target_only_sources=()
while IFS= read -r path; do
    [ -z "$path" ] || target_only_sources["$path"]=1
done < "$target_sources_out"
rm -f "$target_sources_out"

# A repository-wide relocation makes every TU look edited to the per-body gate.
# Check the exact path/ledger mapping, then byte-verify the whole game once.
if migration_marker=$(python3 tools/layout_migration.py detect "$layout_base" :) \
   && [ "$migration_marker" = layout-migration ]; then
    python3 tools/layout_migration.py check "$layout_base" : || fail "layout mapping (see above)"
    python3 tools/check_csv.py --staged || fail "ledger integrity (see above)"
    python3 tools/pin_consistency.py --check || fail "pin consistency (see above)"
    python3 tools/b_pin_check.py --staged || fail "b_<rva> pins (see above)"
    python3 tools/identity_guard.py || fail "identity guard (see above)"
    python3 tools/name_oracle.py --check --staged || fail "name oracle (see above)"
    python3 tools/adopt_header.py --check --staged || fail "header adoption (see above)"
    python3 tools/ledger_guard.py --staged || fail "unstaged ledger edits would be verified instead of the staged ledger (see above)"
    BUILD_POOL="${BUILD_POOL:-4}" python3 tools/gate_baseline.py --check \
        || fail "full game gate after layout migration (see above)"
    echo "PRE-COMMIT OK (complete layout and both targets verified)"
    exit 0
fi

# Gate-read ledger facts (data_rows.csv rows, ...) change only through their one
# writer, which stamps its write in this worktree's git dir (tools/gate_writers.py).
# HEAD's checker, so an edit cannot approve itself; a layout migration exited above.
if git cat-file -e HEAD:tools/gate_writers.py 2>/dev/null; then
    git show HEAD:tools/gate_writers.py | python3 - --staged \
        || fail "a gate-read ledger fact was edited by hand (see above)"
fi

staged_sources=()
staged_c_sources=()
ledger_changed=0
pins_changed=0
wide_change=0
baseline_changed=0
body_baseline_changed=0
full_baseline_changed=0
dir32_record_changed=0
attempts_changed=0
data_rows_changed=0
capture staged_out "listing staged files" git diff --cached --name-only --diff-filter=ACMRT
while IFS= read -r path; do
    [ -z "${target_only_sources[$path]:-}" ] || continue
    case "$path" in
        worldbuilder/*.h|worldbuilder/*.hpp|worldbuilder/*|targets/worldbuilder/*) ;;
        game/*.cpp) staged_sources+=("$path") ;;
        # 216 C sources carry ledger rows (GameSpy, Lua). pre-push byte-verifies an
        # edited one; this hook only collected *.cpp, so such an edit left through
        # the early exit below with nothing verified. Kept apart from
        # staged_sources, whose other consumers parse C++. The ledger also claims
        # .cc, .cxx and .asm sources (pre-push intersects every changed game/ path
        # with it); an edit to one with no row change left the same way. The
        # claimed-source filter below drops any that no matched row names.
        game/*.c|game/*.cc|game/*.cxx|game/*.asm) staged_c_sources+=("$path") ;;
        # Data rows are byte-verified like function rows (delta_sources.py selects
        # their sources), but a commit staging only data_rows.csv took the early
        # exit below: gate_writers proves who wrote a row, not its bytes.
        targets/game/reverse/data_rows.csv) data_rows_changed=1 ;;
        targets/game/reverse/pin_consistency_baseline.csv) baseline_changed=1 ;;
        targets/game/reverse/body_guard_baseline.csv) body_baseline_changed=1 ;;
        # Rows already red on origin: a removed line claims a repair (gate_baseline
        # --validate, HEAD's repair_queue verify-removed), so it may not take the exit.
        targets/game/reverse/full_gate_baseline.txt|targets/game/reverse/dir32_known_red.txt) full_baseline_changed=1 ;;
        # verify_dir32_addresses trusts this record, so a hand edit is a free pass.
        targets/game/reverse/dir32_addresses.csv) dir32_record_changed=1 ;;
        # symbols.csv gets its own flag as well as ledger_changed: a PIN
        # DELETION is byte-verified by a different query than a ledger row is,
        # and only this file can trigger it.
        targets/game/reverse/symbols.csv) ledger_changed=1; pins_changed=1 ;;
        # deleted_rows.csv tombstones are a ledger check_csv judges against functions.csv.
        targets/game/reverse/functions.csv|targets/game/reverse/deleted_rows.csv) ledger_changed=1 ;;
        # A stash-only commit changes no ledger and no source, so without this
        # it takes the early exit below and check_csv never validates the very
        # file it just added. It stays out of the byte-verify set: a banked
        # body is evidence, not a compiled source.
        targets/game/reverse/attempts/*) attempts_changed=1 ;;
        # A header or shim recompiles many TUs while changing NO ledger rows,
        # so the delta byte-verify below would prove nothing. Any such change
        # forces the full gate — this is exactly how a layout-shim experiment
        # could otherwise land a silent regression.
        # mods/ is patched into a copy of the image, never compiled into the byte gate.
        mods/*) ;;
        *.h|inputs/reference/shims/*) wide_change=1 ;;
    esac
done < "$staged_out"
rm -f "$staged_out"
# Deletions and the old side of renames. The ACMRT listing above never shows them,
# so deleting or renaming a ledger, a baseline or the DIR32 record took the early
# exit below and nothing checked it (GPT-6.1-Sol, hook port rounds 1-2). The same
# flags as above; a deleted game/ source is check_csv's to refuse while a row names it.
# (header_dependents --staged already lists deleted headers.)
deleted_source=0
capture deleted_out "listing deleted files" git diff --cached --name-only --no-renames --diff-filter=D
while IFS= read -r path; do
    case "$path" in
        targets/game/reverse/data_rows.csv) data_rows_changed=1 ;;
        targets/game/reverse/pin_consistency_baseline.csv) baseline_changed=1 ;;
        targets/game/reverse/body_guard_baseline.csv) body_baseline_changed=1 ;;
        targets/game/reverse/full_gate_baseline.txt|targets/game/reverse/dir32_known_red.txt) full_baseline_changed=1 ;;
        targets/game/reverse/dir32_addresses.csv) dir32_record_changed=1 ;;
        targets/game/reverse/symbols.csv) ledger_changed=1; pins_changed=1 ;;
        targets/game/reverse/functions.csv|targets/game/reverse/deleted_rows.csv) ledger_changed=1 ;;
        targets/game/reverse/attempts/*) attempts_changed=1 ;;
        game/*) deleted_source=1 ;;
    esac
done < "$deleted_out"
rm -f "$deleted_out"

# A staged .cpp, .c or table that another file #includes compiles inside it, and the
# pattern above misses .inl and .H headers: header_dependents names both, so widen.
if [ "$wide_change" -eq 0 ]; then
    included_out=$(mktemp)
    included_status=0
    python3 tools/header_dependents.py --staged > "$included_out" || included_status=$?
    if [ "$included_status" -eq 2 ] || { [ "$included_status" -eq 0 ] && [ -s "$included_out" ]; }; then
        wide_change=1
    elif [ "$included_status" -ne 0 ]; then
        rm -f "$included_out"
        fail "header_dependents (see above)"
    fi
    rm -f "$included_out"
fi

# Placement: game sources live only under game/ at the official BFME path
# (plus inputs/reference/shims/ for shim headers, inputs/reference/CnC_Generals_Zero_Hour/ for
# restoring vendored EA reference source, and tools/tests/ for fixtures).
# No src/, no invented layouts, no sources at the repo root.
#
# mods/ is allowed too, and deliberately is NOT under game/. It holds mod
# payloads that are patched into a copy of the retail image, never compiled
# into the byte-exact rebuild -- keeping them out of game/ is what stops a mod
# from ever influencing the byte gate. They would fail this check as .asm
# files, so the list names the tree explicitly rather than being bypassed.
#
# targets/game/reverse/attempts/ is named for the same reason: a banked near-miss body is
# evidence for the next agent, never a compiled source, so it must sit outside
# game/ where verify_source_claims would demand matched rows for it.
#
# inputs/vendor/ holds third-party release trees (STLport, d3dx9, nbench, ...),
# each named by its PROVENANCE.md. Moving to a newer upstream release adds that
# release's new headers there, and they have no other home.
capture added_out "listing added files" git diff --cached --name-only --diff-filter=A
while IFS= read -r path; do
    case "$path" in
        worldbuilder/*|targets/worldbuilder/reverse/attempts/*|game/GameEngine/*|game/GameEngineDevice/*|game/Libraries/*|game/gen_small/*|game/gen_asm/*|game/masm_dumps/*|inputs/reference/shims/*|inputs/reference/CnC_Generals_Zero_Hour/*|tools/tests/*|inputs/toolchains/*|inputs/vendor/*|mods/*|targets/game/reverse/attempts/*) ;;
        *) fail "source added outside official tree: $path — see AGENTS.md 'File placement'" ;;
    esac
done < <(grep -E '\.(cpp|c|h|hpp|asm)$' "$added_out" || true)
rm -f "$added_out"

# Every flag set above, so no change this hook knows how to check can skip it: the
# DIR32 record and the body-guard baseline took this exit before (Sol round 2).
if [ "${#staged_sources[@]}" -eq 0 ] && [ "${#staged_c_sources[@]}" -eq 0 ] \
   && [ "$ledger_changed" -eq 0 ] && [ "$data_rows_changed" -eq 0 ] \
   && [ "$wide_change" -eq 0 ] && [ "$baseline_changed" -eq 0 ] \
   && [ "$body_baseline_changed" -eq 0 ] && [ "$full_baseline_changed" -eq 0 ] \
   && [ "$dir32_record_changed" -eq 0 ] \
   && [ "$attempts_changed" -eq 0 ] && [ "$deleted_source" -eq 0 ]; then
    exit 0
fi

# targets/game/reverse/full_gate_baseline.txt is the set of rows already red on origin; it
# may only shrink (tools/gate_baseline.py --validate). While the full gate is
# red a header could never land, and the gate is red partly BECAUSE of header
# fixes it refused, so the check is "no NEW red row",
# not "no red row". A gate that dies before byte comparison still fails.
if git diff --cached --quiet -- targets/game/reverse/full_gate_baseline.txt targets/game/reverse/dir32_known_red.txt; then :; else
    python3 tools/gate_baseline.py --validate || fail "full-gate baseline may only shrink (see above)"
fi
# The build reads the WORKING-TREE ledgers. An unstaged row edit (a rename the
# staged units need) would make them verify green against rows this commit does
# not contain, leaving HEAD inconsistent; refuse before anything is verified.
python3 tools/ledger_guard.py --staged || fail "unstaged ledger edits would be verified instead of the staged ledger (see above)"
if [ "$wide_change" -ne 0 ]; then
    # Byte-verify only the ledger sources the changed headers can reach
    # (tools/header_dependents.py widens on every doubt and exits 2 when it
    # cannot bound the change); otherwise the full gate, as before.
    header_deps_out=$(mktemp)
    if python3 tools/header_dependents.py --staged > "$header_deps_out"; then
        mapfile -t header_deps < "$header_deps_out"
        rm -f "$header_deps_out"
        capture staged_out "listing staged files" git diff --cached --name-only --diff-filter=ACMRT
        while IFS= read -r path; do
            case "$path" in
                *.h|*.hpp|*.hh|*.hxx|*.inl|*.inc|inputs/reference/shims/*|game/*|inputs/*)
                    git diff --quiet -- "$path" || fail "unstaged edits in $path: the scoped header gate would verify the wrong bytes" ;;
            esac
        done < "$staged_out"
        rm -f "$staged_out"
        # The selection was read from the index; build.sh compiles the worktree copy.
        declare -A unstaged=()
        capture unstaged_out "listing unstaged edits" git diff --name-only -z
        while IFS= read -r -d '' path; do unstaged["$path"]=1; done < "$unstaged_out"
        rm -f "$unstaged_out"
        for path in "${header_deps[@]}"; do
            [ -z "${unstaged[$path]:-}" ] || fail "unstaged edits in $path: the scoped header gate would verify the wrong bytes"
        done
        echo "pre-commit: header/shim change — scoped gate over ${#header_deps[@]} dependent source(s)" >&2
        chunk=()
        chunk_bytes=0
        for path in "${header_deps[@]}"; do
            if [ "${#chunk[@]}" -ne 0 ] && [ "$((chunk_bytes + ${#path} + 3))" -gt 24000 ]; then
                BUILD_POOL="${BUILD_POOL:-4}" ./build.sh "${chunk[@]}" || fail "scoped header gate (see above)"
                chunk=()
                chunk_bytes=0
            fi
            chunk+=("$path")
            chunk_bytes=$((chunk_bytes + ${#path} + 3))
        done
        if [ "${#chunk[@]}" -ne 0 ]; then
            BUILD_POOL="${BUILD_POOL:-4}" ./build.sh "${chunk[@]}" || fail "scoped header gate (see above)"
        fi
    else
        rm -f "$header_deps_out"
        echo "pre-commit: header/shim change — running FULL gate against targets/game/reverse/full_gate_baseline.txt (no NEW red row allowed)" >&2
        BUILD_POOL="${BUILD_POOL:-4}" python3 tools/gate_baseline.py --check || fail "full gate after header/shim change: new red row(s) or the gate did not reach byte comparison (see above)"
    fi
fi

# The build verifies file contents on disk; refuse if a file being committed
# also has unstaged edits, or we would be proving the wrong bytes.
# One `git diff` for the worktree, not one per source: 1,500 staged sources cost
# ~1,500 Git processes here otherwise, and a path is matched exactly, not as a pathspec.
capture unstaged_out "listing unstaged edits" git diff --name-only -z
declare -A unstaged_paths=()
while IFS= read -r -d '' path; do unstaged_paths["$path"]=1; done < "$unstaged_out"
rm -f "$unstaged_out"
dirty=()
for path in "${staged_sources[@]}" "${staged_c_sources[@]}"; do
    if [ -n "${unstaged_paths[$path]:-}" ]; then
        dirty+=("$path")
    fi
done
for ledger in targets/game/reverse/functions.csv targets/game/reverse/symbols.csv targets/game/reverse/data_rows.csv targets/game/reverse/pin_consistency_baseline.csv; do
    if ! git diff --cached --quiet -- "$ledger" && ! git diff --quiet -- "$ledger"; then
        dirty+=("$ledger")
    fi
done
if [ "${#dirty[@]}" -ne 0 ]; then
    printf '  unstaged edits in: %s\n' "${dirty[@]}" >&2
    fail "staged verification files also have unstaged edits; build would not verify the staged content"
fi

# 1) Static ledger integrity (<1s): duplicate rows, conflicting or overlapping
#    claims, malformed rows, missing sources. Turns union-merge corruption into
#    an immediate loud failure instead of someone else's red build later.
# The index the reused ledger checks read; the receipt is valid only if the index
# still equals it when this hook succeeds (a late `git add` must void it).
checked_tree="$(git write-tree 2>/dev/null || true)"
python3 tools/check_csv.py --staged || fail "ledger integrity (see above)"

# 1b) Identity, not bytes. targets/game/reverse/symbols.csv is an ADDITIVE candidate list:
#     the REL32 resolver keeps the first pinned address that reproduces retail,
#     so a pin naming the WRONG function still byte-matches and the delta build
#     below proves nothing about it. Only the full gate ran this guard, and a
#     ledger-only edit never triggers the full gate — it takes the scoped path —
#     so the one check built for exactly this change had never run on it. 1.6s,
#     reads only the retail image and the ledgers.
# A baseline change is judged here too: a removed line must be a fixed violation, and
# a deleted or renamed baseline is missing for this check (it refuses).
if [ "$ledger_changed" -ne 0 ] || [ "$baseline_changed" -ne 0 ]; then
    python3 tools/pin_consistency.py --check || fail "pin consistency (see above)"
fi
# 1c) Every b_<rva>() a compiled source calls keeps its ?b_<rva>@@YAXXZ pin.
#     a8ad18240f replaced one with the target's real name instead of adding the
#     name beside it; check_csv, pin_consistency and one_identity all passed and
#     the full gate went red. No compiler, ~1.5s.
b_pin_ran=0
if [ "$ledger_changed" -ne 0 ] || [ "${#staged_sources[@]}" -ne 0 ]; then
    python3 tools/b_pin_check.py --staged || fail "a b_<rva> call lost its pin (see above)"
    b_pin_ran=1
fi
# The baseline is a debt register that may only shrink. --write-baseline refuses
# to grow it, but a hand-typed line is the same anti-pattern, so the committed
# file is checked against HEAD as well.
if [ "$body_baseline_changed" -ne 0 ]; then
    python3 tools/body_guard.py --assert-shrink-only HEAD \
        || fail "body_guard_baseline.csv grew (see above)"
fi
# A deleted debt line is credited as a repair (next_work, progress_v2,
# agent_yield), so its row is re-verified: the delta verify builds staged
# sources, this builds the rest. HEAD's checker, so an edit cannot approve itself.
# Both debt registers: verify-removed reads body_guard_baseline.csv and
# full_gate_baseline.txt, and a full-gate line removed alone was never rebuilt.
if [ "$body_baseline_changed" -ne 0 ] || [ "$full_baseline_changed" -ne 0 ]; then
    if git cat-file -e HEAD:tools/repair_queue.py 2>/dev/null; then
        git show HEAD:tools/repair_queue.py | python3 - verify-removed \
            || fail "a deleted gate-debt line's row still fails its check (see above)"
    fi
fi
if [ "$dir32_record_changed" -ne 0 ]; then
    python3 tools/dir32_record_guard.py --staged HEAD \
        || fail "dir32_addresses.csv changed by hand (see above)"
fi
if [ "$baseline_changed" -ne 0 ]; then
    python3 tools/pin_consistency.py --assert-shrink-only HEAD \
        || fail "pin_consistency_baseline.csv grew (see above)"
fi

# 2) Every function defined in staged sources must be declared in the ledger.
if [ "${#staged_sources[@]}" -ne 0 ]; then
    # On stdin, not argv: ~400 staged sources overflow Windows' 32,767-character command line.
    printf '%s\0' "${staged_sources[@]}" \
        | python3 tools/find_declared_unmatched.py --fail --staged --paths-from - \
        || fail "staged sources define functions the ledger does not declare (see above)"
fi

# 3) Verify changed claims and callers whose callable candidates disappear.
declare -A verify_set=()
declare -A delta_sources=()
for path in "${staged_sources[@]}" "${staged_c_sources[@]}"; do verify_set["$path"]=1; done
delta_out=$(mktemp)
python3 tools/delta_sources.py --staged --selectors > "$delta_out" \
    || { rm -f "$delta_out"; fail "delta_sources (see above)"; }
while IFS= read -r path; do
    [ -z "$path" ] && continue
    case "$path" in
        source:*) delta_sources["${path#source:}"]=1 ;;
        row:*) verify_set["$path"]=1 ;;
        *) fail "untyped delta selector: $path" ;;
    esac
done < "$delta_out"
rm -f "$delta_out"

# 3b) A targets/game/reverse/symbols.csv pin DELETION changes no functions.csv row, so the
#     delta above is blind to it -- yet it re-points the REL32 resolver at a
#     different ICF copy of the name and reddens rows in files this commit never
#     touched. d27ae4b7b deleted 1,599 pins, byte-verified the two files it
#     converted, and left 612 rows red. This asks the complementary question:
#     which claimed rows call an address the deletion just made unreachable.
#     Costs nothing unless symbols.csv is staged, and ~1s when it is.
if [ "$pins_changed" -ne 0 ]; then
    pin_delta_out=$(mktemp)
    python3 tools/delta_sources.py --staged --pins --selectors > "$pin_delta_out" \
        || { rm -f "$pin_delta_out"; fail "delta_sources --pins (see above)"; }
    while IFS= read -r path; do
        [ -z "$path" ] && continue
        case "$path" in
            source:*) delta_sources["${path#source:}"]=1 ;;
            row:*) verify_set["$path"]=1 ;;
            *) fail "untyped pin-delta selector: $path" ;;
        esac
    done < "$pin_delta_out"
    rm -f "$pin_delta_out"
fi

# Source paths paired with row selectors identify the TU whose object evidence
# narrowed the impact. They are cleanliness/existence checks, not permission to
# byte-verify every sibling row in that TU. A staged edited TU is already in
# verify_set above and receives full-source verification.
for path in "${!delta_sources[@]}"; do
    [ -f "$path" ] || fail "delta rows reference missing source $path"
    if ! git diff --quiet -- "$path"; then
        fail "$path differs from the staged snapshot; byte verification would read different source"
    fi
    verify_set["source:$path"]=1
done

# Parked reconstruction drafts (whitelisted zero-matched-row sources) have
# nothing to byte-verify; build.py errors on a filter that matches no rows.
if [ "${#verify_set[@]}" -ne 0 ]; then
    verify_input=$(mktemp)
    verify_removed=$(mktemp) || { rm -f "$verify_input"; fail "temporary verification file"; }
    # printf is a Bash builtin: this expansion never crosses Windows' argv limit.
    printf '%s\0' "${!verify_set[@]}" > "$verify_input"
    python3 - "$verify_input" > "$verify_removed" <<'PY' \
        || { rm -f "$verify_input" "$verify_removed"; fail "filtering claimed sources (see above)"; }
import csv, os, sys
claimed = {r["source"] for r in csv.DictReader(open("targets/game/reverse/functions.csv"))
           if r.get("status") == "matched"}
# a data-only TU owns data_rows.csv rows (tools/data_rows.py) and is verified like any claimed source
if os.path.exists("targets/game/reverse/data_rows.csv"):
    claimed |= {r["source"] for r in csv.DictReader(open("targets/game/reverse/data_rows.csv"))
                if r.get("status") == "matched"}
with open(sys.argv[1], "rb") as stream:
    paths = stream.read().split(b"\0")[:-1]
for path in paths:
    selector = os.fsdecode(path)
    if selector.startswith("row:"):
        continue
    source = selector.removeprefix("source:")
    if source not in claimed:
        sys.stdout.buffer.write(path + b"\0")
PY
    while IFS= read -r -d '' path; do
        unset 'verify_set[$path]'
    done < "$verify_removed"
    rm -f "$verify_input" "$verify_removed"
fi

# A pin naming the wrong function still byte-matches, so nothing above can see
# an identity defect. This runs the two detectors fast enough for a hook (~4s);
# the third, null_reloc, takes ~70s and runs in the full gate instead.
python3 tools/identity_guard.py || fail "a byte-matching row now names the wrong function (see above)"

# A member name is the one naming defect no byte comparison can see: m_pitchShift and
# m_priority compile identically, and the five identity detectors are all keyed on an
# ADDRESS, which a member does not have. This compares the offset a source asserts for
# each member against the offset the ZH<->retail alignment witnesses.
#
# Promoted from shadow on measured evidence. Replaying the last 3,000 commits took
# 2m36s: 1,139 touched game/, 70 introduced a finding the baseline already held, and
# exactly ONE would have been blocked -- cbedb732c, which put m_status at
# WinInstanceData+0xC where the witness has m_style, with a getStatus() reading it.
# A real defect, corrected by hand three commits later in bd878b1eb1; this would have
# caught it at commit time. Zero false positives over 1,139 exposed commits bounds
# the rate under 0.26%.
#
# A finding is still a QUESTION -- the witness is inferred and BFME forked the ZH
# layout -- so it fails against targets/game/reverse/name_oracle_baseline.csv, which may only
# shrink. Settle the disagreement; never add a line to go green.
if [ "${#staged_sources[@]}" -ne 0 ]; then
    python3 tools/name_oracle.py --check --staged \
        || fail "a member name disagrees with the witnessed layout, or this commit adds a placeholder the evidence already names (see above)"
fi

# A type with a canonical header should be included, not redeclared. The
# conversion fleet writes ~1,300 TU-local class bodies a day and ~300 of them are
# for a type a header already defines -- more per day than the adoption lane
# drains, so cleaning up afterwards loses about 2:1. This is the half that wins.
#
# Narrow by construction: only shims that ARE the header's layout and spell
# nothing it brings in, and only for the types that have exactly ONE definition in
# the tree. Coord3D has three headers that disagree; the byte gate cannot pick
# between them, so it is not covered here. See docs/header_adoption.md.
#
# Never a dead end -- the fix is one command, and a shim the compiler will not take
# is recorded in targets/game/reverse/header_adopt_blocked.tsv and skipped from then on.
if [ "${#staged_sources[@]}" -ne 0 ]; then
    python3 tools/adopt_header.py --check --staged \
        || fail "a staged source redeclares a type that has a header (run tools/adopt_header.py --fix-staged)"
fi
# A class registered in targets/game/reverse/canonical_classes.csv (one evidenced
# header, tools/header_adopt_lane.py) gets no NEW private copy, `struct` or
# `class`; existing copies are the lane's queue (header_queue.tsv).
python3 tools/class_gate.py --staged \
    || fail "new private copy of a class with a canonical header (see above)"

# A fixed path count still overflows Windows' 32767-code-unit command line
# when source paths are long. Twice the UTF-8 byte length plus quotes/space
# bounds the quoted UTF-16 argument size; reserve room for launcher/script paths.
measure_verify_argument() {
    local LC_ALL=C
    verify_argument_bytes=$((2 * ${#1} + 3))
}
verify_chunk=()
verify_bytes=0
for path in "${!verify_set[@]}"; do
    measure_verify_argument "$path"
    [ "$verify_argument_bytes" -le 24000 ] || fail "byte-verify selector exceeds argument limit: $path"
    if [ "$((verify_bytes + verify_argument_bytes))" -gt 24000 ]; then
        BUILD_POOL="${BUILD_POOL:-4}" ./build.sh "${verify_chunk[@]}" \
            || fail "byte-verify of changed sources/rows (see above)"
        verify_chunk=()
        verify_bytes=0
    fi
    verify_chunk+=("$path")
    verify_bytes=$((verify_bytes + verify_argument_bytes))
done
if [ "${#verify_chunk[@]}" -ne 0 ]; then
    BUILD_POOL="${BUILD_POOL:-4}" ./build.sh "${verify_chunk[@]}" \
        || fail "byte-verify of changed sources/rows (see above)"
fi

# post-commit re-runs check_csv + b_pin_check for commits that skipped this hook
# (cherry-pick, rebase). Record the tree both passed on, so a normal commit of
# exactly that tree is not checked twice (~4 s each) -- but only when the index
# is still the tree they read and both checkers ran as staged (no unstaged edits
# to their sources). Anything uncertain records nothing, and post-commit then
# checks as before; this optional receipt never fails an otherwise good commit.
if [ -n "$receipt" ] && [ -n "$checked_tree" ] && [ "$b_pin_ran" -eq 1 ] \
   && [ "$(git write-tree 2>/dev/null || true)" = "$checked_tree" ] \
   && git diff --quiet -- tools/check_csv.py tools/b_pin_check.py 2>/dev/null; then
    { printf '%s\n' "$checked_tree" > "$receipt.tmp.$$" && mv -f "$receipt.tmp.$$" "$receipt"; } 2>/dev/null \
        || rm -f "$receipt.tmp.$$" "$receipt" 2>/dev/null || true
fi
echo "PRE-COMMIT OK (ledger integrity + ${#verify_set[@]} verification selector(s) checked)"
