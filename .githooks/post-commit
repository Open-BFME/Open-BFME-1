#!/usr/bin/env bash
# After a commit -- in practice after `git cherry-pick`, the one commit path
# that runs this hook but not pre-commit. Re-check the ledgers when the new
# commit touched them. A rebase in progress is skipped here: post-rewrite
# checks once when it ends. A post hook cannot block; it warns.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
GIT_DIR="$(git rev-parse --git-dir)"
# Tool stamps (tools/gate_writers.py) cover one commit: drop the ones it used.
[ -f tools/gate_writers.py ] && { python3 tools/gate_writers.py --consume 2>/dev/null || true; }
[ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] && exit 0
# pre-commit records the tree it verified with the same two checks; a commit of
# exactly that tree needs no second run. The record is consumed either way.
record="$(git rev-parse --git-path bfme-ledger-verified-tree)"
verified="$(cat "$record" 2>/dev/null || true)"
rm -f "$record"
[ -n "$verified" ] && [ "$verified" = "$(git rev-parse -q --verify 'HEAD^{tree}')" ] && exit 0

if git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null \
        | grep -qE '^targets/game/reverse/(functions|symbols|deleted_rows)\.csv$|^game/.*\.cpp$'; then
    # Beside the hook, not the tree: tests and seats run copies of a hook elsewhere;
    # a copy without its helper uses python3 as before.
    . "$(dirname "${BASH_SOURCE[0]}")/python3.sh" 2>/dev/null || require_python3() { :; }
    require_python3 post-commit warn
    python3 tools/ledger_after_rewrite.py "post-commit" || true
fi
exit 0
