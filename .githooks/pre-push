#!/usr/bin/env bash
# Push gate: static ledger integrity of the outgoing commit + byte-verify of
# every source whose ledger claims changed vs the remote. Bounded by push size
# — never the full gate.
set -euo pipefail

# Publication verifies every affected target; worker selection must not redirect its checks.
unset BFME_TARGET BFME_TARGET_SHA256

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() {
    echo "PRE-PUSH FAILED: $*" >&2
    exit 1
}

refs="$(cat || true)"
remote_name="${1:-origin}"

ZERO=0000000000000000000000000000000000000000

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    # Shared body claims (tools/claims.py) are parentless marker commits with an
    # empty tree, not code: there is no ledger or source in them to verify.
    case "${_remote_ref:-}" in refs/claims/*) continue ;; esac
    [ "$local_sha" = "$ZERO" ] && continue   # deleting a remote ref

    # The SHA on stdin is the destination tip advertised by THIS push
    # negotiation.  Never substitute a possibly stale origin/master here: an
    # ordinary non-fast-forward race must be reported before any expensive
    # checker or compiler starts.  If that advertised object is not local,
    # fetch the actual destination ref and refuse when it moved while we were
    # establishing the base.  A missing object is uncertainty, not permission
    # to validate against a different tree.
    git cat-file -e "$local_sha^{commit}" 2>/dev/null \
        || fail "local pushed commit $local_sha is unavailable"
    base=""
    if [ "$remote_sha" != "$ZERO" ]; then
        if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            if ! git fetch --no-tags "$remote_name" "$_remote_ref"; then
                fail "PUSH RACE: cannot inspect destination $_remote_ref at $remote_sha; retry"
            fi
            fetched="$(git rev-parse FETCH_HEAD^{commit} 2>/dev/null || true)"
            [ "$fetched" = "$remote_sha" ] \
                || fail "PUSH RACE: destination $_remote_ref advanced before verification; retry"
            git cat-file -e "$remote_sha^{commit}" 2>/dev/null \
                || fail "PUSH RACE: destination tip $remote_sha is unavailable; retry"
        fi
        git merge-base --is-ancestor "$remote_sha" "$local_sha" \
            || fail "PUSH RACE: destination $_remote_ref at $remote_sha is not an ancestor of $local_sha; rebase and retry (validation not run)"
        base="$remote_sha"
    fi

    python3 tools/check_csv.py --ref "$local_sha" || fail "ledger integrity at $local_sha (see above)"
    # identity_guard runs at commit time; a commit rebased past a lowered baseline needs this.
    python3 tools/one_identity.py --check-ref "$local_sha" || fail "second real name on one body at $local_sha (see above)"

    git cat-file -e "$local_sha:tools/target_hooks.py" && git diff --quiet "$local_sha" -- tools/target_hooks.py \
        || fail "target checker differs from pushed snapshot; commit or revert its edits"
    if [ -n "$base" ]; then
        python3 tools/target_hooks.py --range "$base" "$local_sha" \
            || fail "WorldBuilder target verification (see above)"
    else
        python3 tools/target_hooks.py --ref "$local_sha" \
            || fail "WorldBuilder target verification (see above)"
    fi
    if [ -z "$base" ]; then
        echo "pre-push: no known remote base; game static ledger check only" >&2
        continue
    fi

    # Direction gate over the OUTGOING range, same call verify_pr.sh makes on a
    # PR. pre-commit runs it too, but --no-verify and clones that never ran
    # tools/setup_hooks.sh skip that entirely, and the byte-verify below cannot
    # see a backward conversion: an __emit spray of retail bytes byte-matches BY
    # CONSTRUCTION. 89 lift commits reached origin through exactly this gap.
    # Runs before the build because it costs a second and the build costs minutes.
    python3 tools/conversion_gate.py "$base" "$local_sha" || fail "conversion direction (see above)"
    for checker in tools/name_regression.py tools/name_history.py tools/name_oracle.py; do
        git cat-file -e "$local_sha:$checker" && git diff --quiet "$local_sha" -- "$checker" \
            || fail "name checker differs from pushed snapshot: $checker; commit or revert its edits"
    done
    python3 tools/name_regression.py "$base" "$local_sha" || fail "descriptive names regressed in outgoing range (see above)"
    # A move of every game TU cannot fit the normal bounded selector list.
    # Recheck the exact migration and whole image against the pushed snapshot.
    if migration_marker=$(python3 tools/layout_migration.py detect "$base" "$local_sha") \
       && [ "$migration_marker" = layout-migration ]; then
        python3 tools/layout_migration.py check "$base" "$local_sha" || fail "layout mapping (see above)"
        git diff --quiet "$local_sha" -- game worldbuilder targets inputs tools \
            || fail "working tree differs from pushed layout snapshot"
        python3 tools/pin_consistency.py --check || fail "pin consistency (see above)"
        python3 tools/b_pin_check.py --ref "$local_sha" || fail "b_<rva> pins (see above)"
        python3 tools/identity_guard.py || fail "identity guard (see above)"
        BUILD_POOL="${BUILD_POOL:-4}" python3 tools/gate_baseline.py --check \
            || fail "full game gate after layout migration (see above)"
        continue
    fi
    python3 tools/name_history.py "$base" "$local_sha" || fail "descriptive names regressed in an outgoing commit (see above)"
    python3 tools/retired_guard.py --range "$base..$local_sha" || fail "retired path re-added in outgoing range (see above)"

    # Identity, for the same reason conversion_gate runs here: byte-verification
    # cannot see it. targets/game/reverse/symbols.csv is an ADDITIVE candidate list, so a pin
    # naming the WRONG function still reproduces its caller's bytes and every
    # scoped build below stays green. This guard only ever ran in the full gate,
    # which no hook path reaches — pre-commit runs it for header/shim changes
    # only, and this hook is bounded by push size and never full — so a wrong
    # pin could reach origin without one check ever looking at it. 1.6s.
    python3 tools/pin_consistency.py --check || fail "pin consistency (see above)"
    python3 tools/pin_consistency.py --assert-shrink-only "$base" --at "$local_sha" \
        || fail "pin_consistency_baseline.csv grew across the outgoing range (see above)"
    python3 tools/b_pin_check.py --ref "$local_sha" || fail "a b_<rva> call lost its pin at $local_sha (see above)"

    # A header/shim or compiler-toolchain change can affect rows whose ledger
    # claims do not move.  The commit hook normally forces the full gate for
    # these, but --no-verify and old clones must not turn that into a push-hook
    # bypass.  Keep the full gate authoritative for this wide dependency class;
    # ordinary functions.csv edits remain selectively cacheable below.
    wide_change=0
    if ! git diff --quiet "$base" "$local_sha" -- \
            '*.h' '*.hpp' 'inputs/reference/shims/*' 'inputs/toolchains/*'; then
        wide_change=1
    fi
    if [ "$wide_change" -ne 0 ]; then
        wide_empty=$(mktemp)
        wide_manifest=$(mktemp)
        : > "$wide_empty"
        python3 tools/verification_cache.py prepare --commit "$local_sha" \
            --selectors-file "$wide_empty" --manifest "$wide_manifest" \
            > /dev/null \
            || { rm -f "$wide_empty" "$wide_manifest"; \
                 fail "wide verification evidence preparation (see above)"; }
        rm -f "$wide_empty" "$wide_manifest"
        BUILD_POOL="${BUILD_POOL:-4}" python3 tools/gate_baseline.py --check \
            || fail "full gate after header/toolchain change (see above)"
        echo "PRE-PUSH OK (full gate after wide dependency change)"
        continue
    fi

    delta_out=$(mktemp)
    python3 tools/delta_sources.py --range "$base" "$local_sha" --selectors > "$delta_out" \
        || { rm -f "$delta_out"; fail "delta_sources (see above)"; }
    mapfile -t delta_raw < "$delta_out"
    rm -f "$delta_out"
    delta_sources=()
    delta_rows=()
    for s in "${delta_raw[@]}"; do
        case "$s" in
            source:*) delta_sources+=("${s#source:}") ;;
            row:*) delta_rows+=("$s") ;;
            *) fail "untyped delta selector: $s" ;;
        esac
    done

    # Sources the range EDITS while leaving their ledger rows alone are absent
    # from that delta, so nothing byte-verifies them — yet one such edit can
    # break every other row in the same translation unit. Disabling a body
    # (#if 0, or just deleting it) removes the inlines and template
    # instantiations only that body referenced, and sibling rows stop resolving
    # with "symbol not found in object": one assignDefaultGadgetLook orphaned 67
    # rows in GameWindowManager.cpp. pre-commit already byte-verifies every
    # staged game/*.cpp for exactly this reason; --no-verify skips pre-commit
    # entirely, so the push gate has to repeat it.
    # Same trap as the two delta_sources calls around it: a process substitution
    # hides this script's exit status, so a crash read as "no edited sources" and
    # the push went out with those translation units unverified.
    edited_out=$(mktemp)
    python3 - "$base" "$local_sha" > "$edited_out" <<'PY' \
        || { rm -f "$edited_out"; fail "listing the edited claimed sources (see above)"; }
import csv, io, subprocess, sys
base, rev = sys.argv[1], sys.argv[2]


def git(*argv):
    return subprocess.run(("git",) + argv, capture_output=True, text=True,
                          check=True).stdout


claimed = {r["source"] for r in csv.DictReader(io.StringIO(
    git("show", "%s:targets/game/reverse/functions.csv" % rev))) if r.get("status") == "matched"}
touched = git("diff", "--name-only", "--diff-filter=ACMRT", base, rev,
              "--", "game/*.cpp", "game/*.c").splitlines()
sys.stdout.reconfigure(newline="\n")
for path in sorted(set(touched) & claimed):
    print(path)
PY
    mapfile -t edited < "$edited_out"
    rm -f "$edited_out"

    # A targets/game/reverse/symbols.csv pin DELETION reddens rows in files the range never
    # touches: it removes a REL32 candidate, and every claimed row whose retail
    # bytes call that address now resolves to a different ICF copy of the name.
    # Neither list above can see it -- both are keyed on functions.csv -- which
    # is how d27ae4b7b pushed 1,599 deletions behind a two-file byte-verify.
    # mapfile cannot see the exit status of the process substitution it reads,
    # so a delta_sources crash used to look exactly like "no pin-affected
    # sources" and the gate waved the push through. Run it to a file first.
    pin_delta=()
    if ! git diff --quiet "$base" "$local_sha" -- targets/game/reverse/symbols.csv; then
        pin_delta_out=$(mktemp)
        python3 tools/delta_sources.py --range "$base" "$local_sha" --pins --selectors > "$pin_delta_out" \
            || { rm -f "$pin_delta_out"; fail "delta_sources --pins (see above)"; }
        mapfile -t pin_delta_raw < "$pin_delta_out"
        rm -f "$pin_delta_out"
        pin_delta_sources=()
        pin_delta_rows=()
        for s in "${pin_delta_raw[@]}"; do
            case "$s" in
                source:*) pin_delta_sources+=("${s#source:}") ;;
                row:*) pin_delta_rows+=("$s") ;;
                *) fail "untyped pin-delta selector: $s" ;;
            esac
        done
    else
        pin_delta_sources=()
        pin_delta_rows=()
    fi

    verify=()
    declare -A seen_verify=() seen_sources=()
    for s in "${edited[@]}" "${delta_sources[@]}" "${pin_delta_sources[@]}"; do
        [ -z "$s" ] && continue
        [ -n "${seen_sources[$s]:-}" ] && continue
        seen_sources["$s"]=1
        [ -f "$s" ] || fail "outgoing rows reference missing source $s"
        git diff --quiet HEAD -- "$s" || fail "$s differs from HEAD; commit or stash before pushing"
    done
    delta_source_selectors=()
    for s in "${delta_sources[@]}" "${pin_delta_sources[@]}"; do
        delta_source_selectors+=("source:$s")
    done
    for s in "${edited[@]}" "${delta_source_selectors[@]}" "${delta_rows[@]}" "${pin_delta_rows[@]}"; do
        [ -z "$s" ] && continue
        [ -n "${seen_verify[$s]:-}" ] && continue
        seen_verify["$s"]=1
        verify+=("$s")
    done
    # Reuse only successful row evidence whose content fingerprint still holds.
    # Source selectors are retained on every invocation for the cheap source
    # claim check; only exact rows with valid receipts leave the compiler list.
    # The helper refuses a dirty relevant worktree, so build.sh cannot verify a
    # different tree from the pushed commit.
    if [ "${#verify[@]}" -ne 0 ]; then
        selector_in=$(mktemp)
        selector_out=$(mktemp)
        cache_manifest=$(mktemp)
        printf '%s\n' "${verify[@]}" > "$selector_in"
        python3 tools/verification_cache.py prepare \
            --commit "$local_sha" --selectors-file "$selector_in" \
            --manifest "$cache_manifest" > "$selector_out" \
            || { rm -f "$selector_in" "$selector_out" "$cache_manifest"; \
                 fail "verification evidence preparation (see above)"; }
        mapfile -t verify < "$selector_out"
        measure_verify_argument() {
            local LC_ALL=C
            verify_argument_bytes=$((2 * ${#1} + 3))
        }
        verify_chunk=()
        verify_bytes=0
        for selector in "${verify[@]}"; do
            measure_verify_argument "$selector"
            [ "$verify_argument_bytes" -le 24000 ] \
                || fail "verification selector exceeds byte-verify argument limit: $selector"
            if [ "${#verify_chunk[@]}" -ne 0 ] \
               && [ "$((verify_bytes + verify_argument_bytes))" -gt 24000 ]; then
                BUILD_POOL="${BUILD_POOL:-4}" ./build.sh "${verify_chunk[@]}" \
                    || fail "byte-verify of outgoing sources/rows (see above)"
                verify_chunk=()
                verify_bytes=0
            fi
            verify_chunk+=("$selector")
            verify_bytes=$((verify_bytes + verify_argument_bytes))
        done
        if [ "${#verify_chunk[@]}" -ne 0 ]; then
            BUILD_POOL="${BUILD_POOL:-4}" ./build.sh "${verify_chunk[@]}" \
                || fail "byte-verify of outgoing sources/rows (see above)"
        fi
        python3 tools/verification_cache.py record --manifest "$cache_manifest" \
            || { rm -f "$selector_in" "$selector_out" "$cache_manifest"; \
                 fail "verification evidence recording (see above)"; }
        rm -f "$selector_in" "$selector_out" "$cache_manifest"
    fi
    echo "PRE-PUSH OK (${#verify[@]} outgoing verification selector(s) checked)"
done <<< "$refs"
