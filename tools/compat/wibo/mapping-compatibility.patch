--- a/test/test_mapview_fixed.c
+++ b/test/test_mapview_fixed.c
@@ -0,0 +1,115 @@
+#include <windows.h>
+
+#ifdef WIBO_TEST_NO_CRT
+#define CHECK(condition, code) do { if (!(condition)) return (code); } while (0)
+#else
+#include "test_assert.h"
+#define CHECK(condition, code) TEST_CHECK(condition)
+#endif
+
+static int run_mapping_test(void) {
+	const DWORD size = 262144;
+	const DWORD granularity = 65536;
+	HANDLE file, mapping;
+	unsigned char *base, *view, *other;
+	MEMORY_BASIC_INFORMATION info;
+	DWORD last, written;
+	int i;
+	static const char passed[] = "MapViewOfFileEx fixed-address fixture passed\n";
+	file = CreateFileA("test_mapview_fixed.tmp", GENERIC_READ | GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+		FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE, NULL);
+	CHECK(file != INVALID_HANDLE_VALUE, 1);
+	mapping = CreateFileMappingA(file, NULL, PAGE_READWRITE, 0, size, NULL);
+	CHECK(mapping != NULL, 2);
+	CHECK(GetFileSize(file, NULL) == size, 3);
+
+	base = (unsigned char *)VirtualAlloc(NULL, size, MEM_RESERVE | MEM_TOP_DOWN, PAGE_READWRITE);
+	CHECK(base != NULL, 4);
+	SetLastError(0);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size, base) == NULL, 5);
+	CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 6);
+	CHECK(VirtualAlloc(base, size, MEM_COMMIT, PAGE_READWRITE) == base, 7);
+	base[0] = 0x31;
+	base[size - 1] = 0x73;
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size, base) == NULL, 8);
+	CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 9);
+	CHECK(base[0] == 0x31 && base[size - 1] == 0x73, 10);
+	CHECK(VirtualFree(base, 0, MEM_RELEASE), 11);
+
+	for (i = 0; i < 32; ++i) {
+		view = (unsigned char *)MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size, base);
+		CHECK(view == base, 12);
+		CHECK(view[0] == (i ? 0xA5 : 0) && view[size - 1] == (i ? 0x5A : 0), 13);
+		view[0] = 0xA5;
+		view[size - 1] = 0x5A;
+		CHECK(VirtualQuery(view, &info, sizeof(info)) == sizeof(info), 14);
+		CHECK(info.BaseAddress == base && info.AllocationBase == base && info.RegionSize == size, 15);
+		CHECK(info.State == MEM_COMMIT && info.Type == MEM_MAPPED && info.Protect == PAGE_READWRITE, 16);
+		CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size, base) == NULL, 17);
+		CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 18);
+		CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, granularity, base + granularity) == NULL, 19);
+		CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 20);
+		CHECK(VirtualAlloc(base, granularity, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE) == NULL, 21);
+		CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 22);
+		CHECK(view[0] == 0xA5 && view[size - 1] == 0x5A, 23);
+		CHECK(UnmapViewOfFile(view), 24);
+		CHECK(VirtualQuery(base, &info, sizeof(info)) == sizeof(info) && info.State == MEM_FREE, 25);
+	}
+
+	/* A later occupied part of the requested interval must also reject the whole map. */
+	other = (unsigned char *)VirtualAlloc(base + granularity * 2, granularity, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+	CHECK(other == base + granularity * 2, 26);
+	other[0] = 0x39;
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size, base) == NULL, 27);
+	CHECK(GetLastError() == ERROR_INVALID_ADDRESS && other[0] == 0x39, 28);
+	CHECK(VirtualFree(other, 0, MEM_RELEASE), 29);
+
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, granularity, base + 1) == NULL, 30);
+	CHECK(GetLastError() == ERROR_MAPPED_ALIGNMENT, 31);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, granularity, base + 4096) == NULL, 32);
+	CHECK(GetLastError() == ERROR_MAPPED_ALIGNMENT, 33);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 1, granularity, base) == NULL, 34);
+	CHECK(GetLastError() == ERROR_MAPPED_ALIGNMENT, 35);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 4096, granularity, base) == NULL, 36);
+	CHECK(GetLastError() == ERROR_MAPPED_ALIGNMENT, 37);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, size, 1, base) == NULL, 38);
+	CHECK(GetLastError() == ERROR_INVALID_PARAMETER, 39);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 1, 0, 1, base) == NULL, 40);
+	CHECK(GetLastError() == ERROR_INVALID_PARAMETER, 41);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size, (LPVOID)0xFFFF0000) == NULL, 42);
+	CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 43);
+
+	/* Nonzero aligned file offsets and null-base calls still work. */
+	view = (unsigned char *)MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, granularity, granularity, base);
+	CHECK(view == base && view[0] == 0, 44);
+	view[0] = 0x18;
+	CHECK(UnmapViewOfFile(view), 45);
+	view = (unsigned char *)MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, 0);
+	CHECK(view != NULL && view[0] == 0xA5 && view[granularity] == 0x18 && view[size - 1] == 0x5A, 46);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size, view) == NULL, 47);
+	CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 48);
+	CHECK(UnmapViewOfFile(view), 49);
+
+#ifdef WIBO_TEST_HOST_LAYOUT
+	/* Wibo's Linux ELF is deliberately loaded here; it is foreign to the guest. */
+	CHECK(*(volatile DWORD *)0x70000000 == 0x464C457F, 50);
+	last = *(volatile DWORD *)0x70000004;
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, granularity, (LPVOID)0x70000000) == NULL, 51);
+	CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 52);
+	CHECK(*(volatile DWORD *)0x70000000 == 0x464C457F && *(volatile DWORD *)0x70000004 == last, 53);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size, (LPVOID)0x7FFF0000) == NULL, 54);
+	CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 55);
+	CHECK(MapViewOfFileEx(mapping, FILE_MAP_ALL_ACCESS, 0, 0, granularity, (LPVOID)0x10000) == NULL, 56);
+	CHECK(GetLastError() == ERROR_INVALID_ADDRESS, 57);
+#endif
+	CHECK(CloseHandle(mapping), 58);
+	CHECK(CloseHandle(file), 59);
+	CHECK(GetFileAttributesA("test_mapview_fixed.tmp") == INVALID_FILE_ATTRIBUTES, 60);
+	WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), passed, sizeof(passed) - 1, &written, NULL);
+	return 0;
+}
+
+int main(void) { return run_mapping_test(); }
+#ifdef WIBO_TEST_NO_CRT
+void __cdecl map_test_entry(void) { ExitProcess((UINT)main()); }
+#endif
