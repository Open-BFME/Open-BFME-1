+int WINAPI StringFromGUID2(const GUID *rguid, LPWSTR lpsz, int cchMax) {
+	HOST_CONTEXT_GUARD();
+	DEBUG_LOG("StringFromGUID2(%p, %p, %d)\n", rguid, lpsz, cchMax);
+	constexpr int kGuidStringLength = 39; // Includes braces and the terminator.
+	if (cchMax < kGuidStringLength) {
+		return 0;
+	}
+
+	const GUID guid = *rguid;
+	constexpr char kHexDigits[] = "0123456789ABCDEF";
+	WCHAR *cursor = lpsz;
+	auto writeHex = [&](uint32_t value, int digits) {
+		for (int shift = (digits - 1) * 4; shift >= 0; shift -= 4) {
+			*cursor++ = static_cast<WCHAR>(kHexDigits[(value >> shift) & 0xF]);
+		}
+	};
+	*cursor++ = '{';
+	writeHex(guid.Data1, 8);
+	*cursor++ = '-';
+	writeHex(guid.Data2, 4);
+	*cursor++ = '-';
+	writeHex(guid.Data3, 4);
+	*cursor++ = '-';
+	for (int i = 0; i < 8; ++i) {
+		if (i == 2) {
+			*cursor++ = '-';
+		}
+		writeHex(guid.Data4[i], 2);
+	}
+	*cursor++ = '}';
+	*cursor = 0;
+	return kGuidStringLength;
+}
